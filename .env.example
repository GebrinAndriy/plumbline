DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Optional: token from @BotFather. Without it, new leads are only shown in the dashboard.
TELEGRAM_BOT_TOKEN=
# Secret for /api/cron/purge. Vercel Cron sends it as "Authorization: Bearer <secret>".
# Generate one with: openssl rand -hex 32
CRON_SECRET=
# Optional, production only: with it Telegram pushes /start messages to /api/telegram/webhook
# instead of the dashboard polling getUpdates. Register it with: npm run telegram:webhook
TELEGRAM_WEBHOOK_SECRET=
# Public https address of the deployment. Required in production for password reset links,
# and used by npm run telegram:webhook. In development links use the address you opened.
APP_URL=
# Optional in development: without them, emails are printed to the server log instead of sent.
# Required in production. Key from resend.com; the sender must be on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=Plumbline <no-reply@example.com>
